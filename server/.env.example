PORT=5000
MONGODB_URI=mongodb://localhost:27017/digibhoomi
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
PYTHON_OCR_SERVICE_URL=http://127.0.0.1:8000

# Initial administrator account. Set both values before starting the server.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set true when serving over HTTPS in production.
COOKIE_SECURE=false

# Google Gemini API Configuration (Phase 3 Primary Engine)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
